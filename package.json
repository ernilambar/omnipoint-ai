{
	"name": "omnipoint-ai",
	"version": "1.0.3",
	"description": "AI provider for OpenAI-compatible endpoints.",
	"keywords": [
		"wordpress",
		"wordpress-plugin"
	],
	"homepage": "https://github.com/ernilambar/omnipoint-ai",
	"bugs": {
		"url": "https://github.com/ernilambar/omnipoint-ai/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ernilambar/omnipoint-ai.git"
	},
	"license": "GPL-2.0-or-later",
	"author": "Nilambar Sharma",
	"main": "omnipoint-ai.php",
	"scripts": {
		"predeploy": "rimraf deploy vendor && pnpm run ready",
		"deploy": "packtor",
		"format": "prettier . --write --log-level warn",
		"ready": "pnpm run vendor",
		"vendor": "composer install --no-dev --no-scripts -o",
		"version": "easy-replace-in-files"
	},
	"browserslist": "> 1%, last 2 versions, not dead",
	"prettier": "@wordpress/prettier-config",
	"devDependencies": {
		"@wordpress/prettier-config": "^4.55.0",
		"easy-replace-in-files": "^2.0.0",
		"packtor": "^2.0.0",
		"prettier": "npm:wp-prettier@3.9.6",
		"rimraf": "^6.1.3"
	},
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=22",
		"pnpm": ">=12"
	}
}
